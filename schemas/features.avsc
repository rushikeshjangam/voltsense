{
  "type": "record",
  "name": "FeatureVector",
  "namespace": "voltsense.features",
  "doc": "Per-window extracted features for one channel of one asset, produced by the Flink feature job from RawTelemetry. Phase 1 Step 3b-i added TIME-DOMAIN features (rms, peak, crest_factor, kurtosis). Step 3b-ii ADDS frequency-domain bearing-fault band energies (bpfi/bpfo/bsf/ftf/shaft_1x). NOTE ON REGISTRATION: the live schema under subject 'features-value' is generated by Flink's avro-confluent sink from the sink table DDL; this .avsc is the hand-authored logical contract the DDL mirrors. NOTE ON LABELS: the 'fault' record is carried as METADATA ONLY (passed through from raw-telemetry) — features are computed from the samples, never derived from the label. BACKWARD-COMPATIBLE EVOLUTION: subject compatibility is BACKWARD — the 3b-ii fields were added as NULLABLE unions with default null (e.g. [\"null\",\"double\"], default null), so a reader on the new schema can still decode an old 3b-i record: missing fields are filled with null instead of erroring. Any further additions should follow the same nullable-with-default pattern.",
  "fields": [
    {"name": "asset_id", "type": "string", "doc": "Asset identifier, carried through from raw-telemetry; also the Kafka partition key."},
    {"name": "timestamp_ms", "type": "long", "doc": "Epoch-ms of the first sample of the window this feature vector summarises."},
    {"name": "window_index", "type": "long", "doc": "0-based window index within the source recording (carried through)."},
    {"name": "channel", "type": "string", "doc": "Accelerometer channel (DE/FE/BA) the features were computed from. String, not enum (avro-confluent can't read Avro enums)."},
    {"name": "sample_rate_hz", "type": "int", "doc": "Sample rate of the source window in Hz (needed to interpret the future frequency-domain features)."},
    {
      "name": "fault",
      "type": {
        "type": "record",
        "name": "FaultLabel",
        "doc": "CWRU ground-truth metadata, passed through unchanged. METADATA ONLY — never an input to feature computation.",
        "fields": [
          {"name": "type", "type": "string", "doc": "NORMAL / INNER_RACE / OUTER_RACE / BALL."},
          {"name": "fault_diameter_in", "type": ["null", "double"], "default": null, "doc": "Defect size in inches; null for NORMAL."},
          {"name": "load_hp", "type": "int", "doc": "Motor load in HP (0-3)."}
        ]
      },
      "doc": "Ground-truth labels carried from raw-telemetry for validation only."
    },

    {"name": "rms", "type": "double", "doc": "Root-mean-square amplitude of the window = sqrt(mean(x^2)). Overall vibration ENERGY level."},
    {"name": "peak", "type": "double", "doc": "Peak amplitude = max(|x|). The single largest excursion in the window."},
    {"name": "crest_factor", "type": "double", "doc": "peak / rms. IMPULSIVENESS: high when sharp transient spikes ride on a low background (classic of localised bearing impacts)."},
    {"name": "kurtosis", "type": "double", "doc": "Excess kurtosis = mean((x-mu)^4)/var^2 - 3. SPIKINESS vs a Gaussian: ~0 for normal random vibration, large and positive for impulsive fault signatures."},

    {"name": "bpfi_band_energy", "type": ["null", "double"], "default": null, "doc": "Step 3b-ii. Sum of squared FFT magnitude in a +-10Hz band around the Ball Pass Frequency Inner-race (BPFI = 5.4152 x shaft_hz). High for INNER_RACE faults: each rolling element striking the inner-race defect once per pass excites this frequency and its harmonics. Nullable with default null so 3b-i records (which lack this field) remain readable under BACKWARD compatibility."},
    {"name": "bpfo_band_energy", "type": ["null", "double"], "default": null, "doc": "Step 3b-ii. Sum of squared FFT magnitude in a +-10Hz band around the Ball Pass Frequency Outer-race (BPFO = 3.5848 x shaft_hz). High for OUTER_RACE faults: rolling elements striking a fixed outer-race defect once per pass. Nullable/default null for BACKWARD compatibility with 3b-i records."},
    {"name": "bsf_band_energy", "type": ["null", "double"], "default": null, "doc": "Step 3b-ii. Sum of squared FFT magnitude in a +-10Hz band around the Ball Spin Frequency (BSF = 2.3574 x shaft_hz). High for BALL faults: a defect on a rolling element strikes both races as the ball spins on its own axis. Nullable/default null for BACKWARD compatibility with 3b-i records."},
    {"name": "ftf_band_energy", "type": ["null", "double"], "default": null, "doc": "Step 3b-ii. Sum of squared FFT magnitude in a +-10Hz band around the Fundamental Train Frequency (FTF = 0.3983 x shaft_hz), i.e. the cage/orbit rotation frequency. Rarely dominant alone but useful as a cage-wear indicator. Nullable/default null for BACKWARD compatibility with 3b-i records."},
    {"name": "shaft_1x_energy", "type": ["null", "double"], "default": null, "doc": "Step 3b-ii. Sum of squared FFT magnitude in a +-10Hz band around 1x shaft rotation frequency (shaft_hz = rpm/60). BASELINE REFERENCE: imbalance/misalignment shows up here, not at the bearing fault frequencies, so this helps distinguish bearing faults from other mechanical issues. Nullable/default null for BACKWARD compatibility with 3b-i records."}
  ]
}
